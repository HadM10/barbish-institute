# Copy to .env for local development. On Heroku, set these as Config Vars.

PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=barbish_institute
DB_PORT=3306
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
AZURE_STORAGE_CONNECTION_STRING=

# --- Career assessment (Claude API) ---
# Required. Create a key at https://platform.claude.com (Settings > API keys).
ANTHROPIC_API_KEY=
# Optional. Defaults shown.
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=medium
# Optional safety limits.
MAX_ASSESSMENTS_PER_DAY=1000
ASSESSMENT_CONCURRENCY=3
